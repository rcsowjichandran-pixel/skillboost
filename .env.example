DJANGO_SECRET_KEY=generate-a-unique-secret-for-this-deployment
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECURE_SSL_REDIRECT=false

# Leave DB_ENGINE unset to use the local SQLite database.
# Set DB_ENGINE=mysql and provide the values below to use MySQL.
# DB_ENGINE=mysql
# DB_NAME=skillboost
# DB_USER=your_mysql_user
# DB_PASSWORD=your_mysql_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

GEMINI_API_KEY=your-google-ai-studio-api-key
